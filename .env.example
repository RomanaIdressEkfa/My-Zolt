# এই ফাইলটা কপি করে ".env" নামে রাখুন, তারপর মানগুলো বসান।

AGENT_NAME=Zolt

# Telegram-এ @BotFather থেকে পাওয়া token
TELEGRAM_BOT_TOKEN=

# প্রথমবার bot-কে message দিলে সে আপনার ID বলে দেবে, সেটা এখানে বসান
ALLOWED_TELEGRAM_USER_ID=

# আপনার project গুলো যেখানে থাকে
PROJECTS_DIR=C:\laragon\www

# ======================= AI MODELS =======================
# অন্তত একটা key দিন। যতগুলো দেবেন, Zolt MODEL_ORDER অনুযায়ী
# প্রথমটা দিয়ে চেষ্টা করবে, সীমা শেষ বা error হলে পরেরটায় যাবে।
MODEL_ORDER=claude,gemini,groq,openrouter,custom,mistral

# Google Gemini (free) - aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# Groq (free) - console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# OpenRouter (free model আছে) - openrouter.ai -> Keys
# Model: openrouter.ai/models-এ "free" খুঁজে নাম বসান (":free" দিয়ে শেষ হয় এমন)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free

# Mistral (free tier) - console.mistral.ai -> API Keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# যেকোনো OpenAI-compatible service (যেমন অন্য কোনো platform-এর token)
# তাদের docs থেকে base URL, key আর model-এর নাম বসান
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Claude (paid) - console.anthropic.com। না থাকলে ফাঁকা রাখুন।
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# নিজের app যোগ করতে: APP_<নাম>=path   (যেমন নিচে)
# APP_PHOTOSHOP=C:\Program Files\Adobe\Adobe Photoshop 2025\Photoshop.exe

# Voice -> text (Groq-এর free Whisper, GROQ_API_KEY লাগবে)
VOICE_MODEL=groq/whisper-large-v3

# ঐচ্ছিক: ভিডিওর ছবি দ্রুত বানাতে free key - enter.pollinations.ai
POLLINATIONS_KEY=
